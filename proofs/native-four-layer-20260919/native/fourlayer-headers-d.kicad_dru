(version 1)

(rule "EVLEDA_PLANE_d524c342e33b_P01_THERMAL"
  (layer "In2.Cu")
  (condition "A.Type == 'Zone' && A.Name == 'EVLEDA_PLANE_d524c342e33b_P01'")
  (severity error)
  (constraint min_resolved_spokes 2)
  (constraint thermal_relief_gap (min 0.25mm))
  (constraint thermal_spoke_width (min 0.5mm) (opt 0.5mm) (max 0.5mm)))

(rule "EVLEDA_PLANE_d524c342e33b_P02_THERMAL"
  (layer "In1.Cu")
  (condition "A.Type == 'Zone' && A.Name == 'EVLEDA_PLANE_d524c342e33b_P02'")
  (severity error)
  (constraint min_resolved_spokes 2)
  (constraint thermal_relief_gap (min 0.25mm))
  (constraint thermal_spoke_width (min 0.5mm) (opt 0.5mm) (max 0.5mm)))
