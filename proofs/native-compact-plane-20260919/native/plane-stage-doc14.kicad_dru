(version 1)

(rule "EVLEDA_PLANE_d37e2a971df9_P01_THERMAL"
  (layer "B.Cu")
  (condition "A.Type == 'Zone' && A.Name == 'EVLEDA_PLANE_d37e2a971df9_P01'")
  (severity error)
  (constraint min_resolved_spokes 2)
  (constraint thermal_relief_gap (min 0.25mm))
  (constraint thermal_spoke_width (min 0.5mm) (opt 0.5mm) (max 0.5mm)))
