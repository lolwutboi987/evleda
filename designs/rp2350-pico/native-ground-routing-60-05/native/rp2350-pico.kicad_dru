  (condition "A.Type == 'Pad' && A.Reference == 'H3'")
  (severity error)
  (constraint physical_hole_clearance (min 0.25mm)))

(rule "EVLEDA_H4_NPTH_COPPER"
  (condition "A.Type == 'Pad' && A.Reference == 'H4'")
