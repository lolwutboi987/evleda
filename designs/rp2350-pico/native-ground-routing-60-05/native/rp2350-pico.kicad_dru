(version 1)

(rule "EVLEDA_NUMERIC_FALLBACK"
  (severity error)
  (constraint track_width (min 0.2mm))
  (constraint edge_clearance (min 0.5mm)))

(rule "EVLEDA_NUMERIC_PAD_FALLBACK"
  (condition "A.Type == 'Pad'")
  (severity error)
  (constraint hole_size (min 0.3mm))
  (constraint annular_width (min 0.1mm)))

(rule "EVLEDA_NUMERIC_NET_1"
  (condition "A.NetName == '1V1'")
  (severity error)
  (constraint track_width (min 0.2mm))
  (constraint edge_clearance (min 0.5mm)))

