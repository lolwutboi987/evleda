(rule "EVLEDA_NUMERIC_VIA"
  (condition "A.Type == 'Via'")
  (severity error)
  (constraint via_diameter (min 0.55mm))
  (constraint hole_size (min 0.2mm))
  (constraint annular_width (min 0.15mm)))

(rule "EVLEDA_H1_NPTH_COPPER"
  (condition "A.Type == 'Pad' && A.Reference == 'H1'")
  (severity error)
  (constraint hole_clearance (min 0.25mm)))

(rule "EVLEDA_H1_NPTH_PHYSICAL_COPPER"
  (layer outer)
  (condition "A.Type == 'Pad' && A.Reference == 'H1'")
  (severity error)
  (constraint physical_hole_clearance (min 0.25mm)))

(rule "EVLEDA_H2_NPTH_COPPER"
  (condition "A.Type == 'Pad' && A.Reference == 'H2'")
  (severity error)
  (constraint hole_clearance (min 0.25mm)))

(rule "EVLEDA_H2_NPTH_PHYSICAL_COPPER"
  (layer outer)
  (condition "A.Type == 'Pad' && A.Reference == 'H2'")
  (severity error)
  (constraint physical_hole_clearance (min 0.25mm)))

