{"_meta":{"evledaQualifiedFootprintIdentitySync":"evleda.kicad-qualified-footprint-identity-sync.v1"},"annotations":{"idempotentHint":false},"description":"Sync missing PCB footprints from schematic footprint assignments.\n\nThis is a file-based operation intended for initial board bring-up. It adds\nmissing footprint instances to the `.kicad_pcb` file using schematic\nreferences, values, rotations, and assigned `Library:Footprint` names.\nWhen `replace_mismatched=True`, existing footprints with the same\nreference but the wrong footprint name are replaced in place.","inputSchema":{"properties":{"allow_open_board":{"default":false,"title":"Allow Open Board","type":"boolean"},"auto_place":{"default":true,"title":"Auto Place","type":"boolean"},"force":{"default":false,"title":"Force","type":"boolean"},"grid_mm":{"default":2.54,"title":"Grid Mm","type":"number"},"origin_x_mm":{"default":20,"title":"Origin X Mm","type":"number"},"origin_y_mm":{"default":20,"title":"Origin Y Mm","type":"number"},"replace_mismatched":{"default":false,"title":"Replace Mismatched","type":"boolean"},"scale_x":{"default":1,"title":"Scale X","type":"number"},"scale_y":{"default":1,"title":"Scale Y","type":"number"},"use_net_names":{"default":true,"title":"Use Net Names","type":"boolean"}},"title":"pcb_sync_from_schematicArguments","type":"object"},"name":"pcb_sync_from_schematic","outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"pcb_sync_from_schematicOutput","type":"object"}}