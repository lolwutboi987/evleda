(kicad_pcb
  (version 20260101)
  (generator pcbnew)
  (generator_version 10.0.0)
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (34 "B.Paste" user "b.paste")
    (35 "F.Paste" user "f.paste")
    (36 "B.SilkS" user "b.silkscreen")
    (37 "F.SilkS" user "f.silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user))
  (setup (pad_to_mask_clearance 0))
  (net 0 "")
  (net 1 "GND")
  (net 2 "SIG")
  (footprint "Sensor:Deterministic_SMD"
    (layer "F.Cu")
    (uuid 00000000-0000-4000-8000-000000000101)
    (at 10 10 90)
    (property "Reference" "U1"
      (at 0 -2)
      (layer "F.SilkS"))
    (property "Value" "SENSOR")
    (attr smd)
    (fp_rect
      (start -2 -1.5)
      (end 2 1.5)
      (stroke (width 0.15) (type default))
      (fill none)
      (layer "F.SilkS"))
    (pad "1" smd roundrect
      (at -1 0)
      (size 1.2 1.6)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net 1 "GND")
      (pinfunction "GND")
      (pintype "power_in")
      (roundrect_rratio 0.25)
      (uuid 00000000-0000-4000-8000-000000000111))
    (pad "2" smd rect
      (at 1 0)
      (size 1.2 1.6)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "SIG")
      (pinfunction "OUT")
      (pintype "output")
      (uuid 00000000-0000-4000-8000-000000000112)))
  (footprint "Connector:Deterministic_THT"
    (layer "F.Cu")
    (uuid 00000000-0000-4000-8000-000000000201)
    (at 30 10)
    (property "Reference" "J1")
    (property "Value" "HEADER")
    (attr through_hole)
    (pad "1" thru_hole circle
      (at 0 0)
      (size 1.8 1.8)
      (drill 0.9)
      (layers "*.Cu" "*.Mask")
      (net 1 "GND")
      (pinfunction "GND")
      (pintype "passive")
      (uuid 00000000-0000-4000-8000-000000000211)))
  (gr_line
    (start 0 0)
    (end 40 0)
    (stroke (width 0.05) (type default))
    (layer "Edge.Cuts")
    (uuid 00000000-0000-4000-8000-000000000301))
  (gr_line
    (start 40 0)
    (end 40 25)
    (stroke (width 0.05) (type default))
    (layer "Edge.Cuts")
    (uuid 00000000-0000-4000-8000-000000000302))
  (gr_line
    (start 40 25)
    (end 0 25)
    (stroke (width 0.05) (type default))
    (layer "Edge.Cuts")
    (uuid 00000000-0000-4000-8000-000000000303))
  (gr_line
    (start 0 25)
    (end 0 0)
    (stroke (width 0.05) (type default))
    (layer "Edge.Cuts")
    (uuid 00000000-0000-4000-8000-000000000304))
  (segment
    (start 11 10)
    (end 18 10)
    (width 0.25)
    (layer "F.Cu")
    (net 2)
    (uuid 00000000-0000-4000-8000-000000000401))
  (segment
    (start 18 10)
    (end 25 10)
    (width 0.25)
    (layer "B.Cu")
    (net 2)
    (uuid 00000000-0000-4000-8000-000000000402))
  (via
    (at 18 10)
    (size 0.8)
    (drill 0.4)
    (layers "F.Cu" "B.Cu")
    (net 2)
    (uuid 00000000-0000-4000-8000-000000000501))
  (zone
    (net 1)
    (net_name "GND")
    (layer "F.Cu")
    (uuid 00000000-0000-4000-8000-000000000601)
    (name "GROUND")
    (hatch edge 0.5)
    (connect_pads (clearance 0.2))
    (min_thickness 0.25)
    (polygon
      (pts
        (xy 1 1)
        (xy 39 1)
        (xy 39 24)
        (xy 1 24)))))
