+def _netlist_child_blocks(block: str, keyword: str) -> list[str]:
+    """Select direct fields without treating quoted text as netlist structure."""
+    children: list[str] = []
+    cursor = 1
+    while cursor < len(block):
+        if block[cursor] == '"':
+            quoted = re.match(STRING_PATTERN, block[cursor:])
+            if quoted is None:
+                return []
+            cursor += quoted.end()
+        elif block[cursor] == "(":
+            child, length = _extract_block(block, cursor)
+            if not child:
+                return []
+            if re.match(rf"\({keyword}(?=\s|\))", child):
+                children.append(child)
+            cursor += length
+        else:
+            cursor += 1
+    return children
+
