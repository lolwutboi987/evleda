+def _unpack(item: Any, message_type: Any) -> Message:
+    message = message_type()
+    if not item.Is(message.DESCRIPTOR) or not item.Unpack(message):
+        raise ToolError("Native response contains an unexpected item type.")
+    _raw(message)
+    return message
