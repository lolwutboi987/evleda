+def _power_flag_connectivity_pin(
+    content: str, symbol: dict[str, Any]
+) -> tuple[tuple[float, float], dict[str, str]]:
+    """Bind the flag endpoint to its embedded source definition, never a net name."""
+    libraries = re.search(r"\(lib_symbols\b", content)
+    library_block = _extract_block(content, libraries.start())[0] if libraries else ""
+    definitions = [block for name, block in _extract_child_symbol_blocks(library_block)
+                   if name == "power:PWR_FLAG"]
+    records: list[dict[str, Any]] = []
+    all_records: list[dict[str, Any]] = []
+    if len(definitions) == 1:
+        definition = definitions[0]
+        all_records = _extract_pin_records(definition)
+        records.extend(_extract_pin_records(_strip_child_symbol_blocks(definition)))
+        for name, child in _extract_child_symbol_blocks(definition):
+            if name.startswith(("PWR_FLAG_0_", "PWR_FLAG_1_")):
+                records.extend(_extract_pin_records(child))
+    if (int(symbol["unit"]) != 1 or len(records) != 1
+            or len(all_records) != 1
+            or records[0]["number"] != "1" or records[0]["etype"] != "power_out"
+            or float(records[0]["x"]) != 0.0 or float(records[0]["y"]) != 0.0):
+        raise ValueError("power:PWR_FLAG requires one embedded power_out pin numbered 1 at its origin.")
+    record = records[0]
+    rx, ry = rotate_point(float(record["x"]), -float(record["y"]), int(symbol["rotation"]))
+    point = _point_key(float(symbol["x"]) + rx, float(symbol["y"]) + ry)
+    return point, {
+        "reference": str(symbol["reference"]), "pin": str(record["number"]),
+        "value": str(symbol["value"]), "name": str(record["name"]),
+        "etype": str(record["etype"]),
+    }
+
