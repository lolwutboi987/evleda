# Retained local-only plans from the superseded standalone browser/CAD
# prototype.  EvlEDA's public product is a local stdio MCP + skill for an
# already-installed KiCad; these files must not be re-added by ``git add -A``.
/docs/CONFIGURATION.md
/docs/EVLEDA_COMPARISON_RESEARCH.md
/docs/EXACT_PREVIEW_CONTRACT.md
/docs/FEATURE_PARITY.md
/docs/IMPORT_EXPORT_CONTRACT.md
/docs/IMPORT_STAGE_INTEGRATION_PLAN.md
/docs/PARITY_ROADMAP.md

# KiCad runtime state, auto-saves, locks, and local library caches. Design
# source such as .kicad_pcb, .kicad_sch, and .kicad_pro remains trackable.
*.kicad_prl
*.kicad_pro.user
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_sch-*
*.kicad_pcb-*
*.lck
*.lock
fp-info-cache
sym-lib-table.cache
/.kicad/
/backups/
/**/backups/

# Private evidence, live-worker state, and logs. Public, reviewed receipts
# must be copied into examples/ deliberately rather than generated in place.
/.evleda/
/.evleda-state/
/private-evidence/
/evidence-private/
/runtime-evidence/
/worker-state/
