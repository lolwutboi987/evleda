{
  "name": "evleda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "evleda-fluxctl": "./dist/src/cli/flux-control.js"
  },
  "description": "Local-first, evidence-bound robotics PCB candidate workflow for KiCad.",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm run check:kicad-inspection-runtime && node scripts/verify-codex-cli-profile-evidence.mjs && node scripts/verify-deep-rule-resources.mjs && node scripts/verify-native-schematic-style-seed.mjs && tsc -p tsconfig.build.json && node scripts/package-deep-rule-resources.mjs && node scripts/package-native-schematic-style-seed.mjs && node scripts/package-toolbox-native-helper.mjs && node scripts/test-deep-rule-package.mjs && node scripts/test-native-schematic-style-package.mjs && vite build --config ui/vite.config.ts",
    "check:codex-cli-evidence": "node scripts/verify-codex-cli-profile-evidence.mjs",
    "check:deep-rule-resources": "node scripts/verify-deep-rule-resources.mjs",
    "check:kicad-inspection-runtime": "node scripts/verify-kicad-inspection-runtime.mjs",
    "setup:destination": "node scripts/setup-destination-runtime.mjs",
    "check:source-emits": "node scripts/verify-no-source-adjacent-emits.mjs",
    "dev": "concurrently -k -n daemon,ui -c yellow,cyan \"pnpm dev:daemon\" \"pnpm dev:ui\"",
    "dev:flux": "pnpm dev",
    "dev:daemon": "tsx src/api/main.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "mcp": "tsx src/mcp/main.ts",
    "mcp:toolbox": "tsx src/mcp/toolbox-main.ts",
    "mcp:toolbox:native": "tsx src/mcp/toolbox-native-main.ts",
    "mcp:toolbox:workspace": "tsx src/mcp/toolbox-workspace-main.ts",
    "pcb-agent": "tsx src/cli/pcb-agent.ts",
    "fluxctl": "tsx src/cli/flux-control.ts",
    "start": "node scripts/verify-deep-rule-resources.mjs --dist && node dist/src/api/main.js",
    "start:flux": "pnpm start",
    "test": "pnpm run check:source-emits && pnpm run check:deep-rule-resources && pnpm run check:kicad-inspection-runtime && vitest run --maxWorkers=1",
    "test:watch": "pnpm run check:source-emits && pnpm run check:deep-rule-resources && vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "fastify": "5.12.1",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
