(version 1)

(rule "EVLEDA_PLANE_22b8b297e6cc_P01_THERMAL"
  (layer "B.Cu")
  (condition "A.Type == 'Zone' && A.Name == 'EVLEDA_PLANE_22b8b297e6cc_P01'")
  (severity error)
  (constraint min_resolved_spokes 2)
  (constraint thermal_relief_gap (min 0.2mm))
  (constraint thermal_spoke_width (min 0.25mm) (opt 0.25mm) (max 0.25mm)))
